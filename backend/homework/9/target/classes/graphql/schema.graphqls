type Director {
  id: ID!
  name: String!
}

type Review {
  comment: String!
  rating: Int!
}

type Movie {
  id: ID!
  title: String!
  genre: String!
  directorId: ID!
  director: Director
  reviews: [Review!]!
}

type Query {
  findMovieById(id: ID!): Movie
}

type Mutation {
  addReview(movieId: ID!, comment: String!, rating: Int!): Movie
}
